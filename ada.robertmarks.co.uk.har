            "text": "{\"cash_flow_classification\":null,\"concept\":{\"abstract\":false,\"balance\":\"credit\",\"full_type\":\"xbrli:monetaryItemType\",\"local_name\":\"ProfitLoss\",\"namespace\":\"http://xbrl.frc.org.uk/fr/2026-01-01/core\",\"nillable\":\"true\",\"period_type\":\"duration\",\"preferred_label_role\":null,\"qname\":\"core:ProfitLoss\",\"substitution_group\":\"xbrli:item\",\"xbrl_type\":\"monetaryItemType\"},\"cross_ref_destination\":null,\"hypercubes\":[\"core:EquitySOCIHypercube\",\"core:Income-MainHypercube\",\"dpl:DetailedProfitLossHypercube\"],\"labels\":[{\"label_text\":\"When ALL data is continuing and no discontinued values are reported, the 'continuing operations' dimension tag need NOT be individually applied.  The default dimension tag representing the total value for continuing and discontinued values may be considered to apply.\",\"lang\":\"en\",\"type\":\"Documentation\"},{\"label_text\":\"Profit (loss)\",\"lang\":\"en\",\"type\":\"Standard Label\"},{\"label_text\":\"Pan fo'r HOLL ddata yn parhau ac na adroddir am werthoedd nad ydynt yn parhau, NID oes raid cymhwyso tag dimensiwn 'gweithrediad sy'n parhau' yn unigol.  Gellir ystyried bod y tag dimensiwn diofyn sydd yn cynrychioli'r cyfanswm gwerth ar gyfer gwerthoedd sydd ac sydd ddim yn parhau yn gymwys.\",\"lang\":\"cy\",\"type\":\"Documentation\"},{\"label_text\":\"Elw (colled)\",\"lang\":\"cy\",\"type\":\"Standard Label\"}],\"references\":[{\"name\":\"FRS\",\"number\":\"102\",\"paragraph\":\"5.5\",\"part\":null,\"reference_key_values\":{\"Name\":\"FRS\",\"Number\":\"102\",\"Paragraph\":\"5.5\",\"reference_role_uri\":\"http://xbrl.frc.org.uk/general/ref/roles/FRS102\"},\"reference_role\":\"FRS 102\",\"reference_role_uri\":\"http://xbrl.frc.org.uk/general/ref/roles/FRS102\",\"report\":null,\"schedule\":null,\"section\":null,\"year\":null},{\"name\":\"IAS\",\"number\":\"1\",\"paragraph\":\"81A.a\",\"part\":null,\"reference_key_values\":{\"Name\":\"IAS\",\"Number\":\"1\",\"Paragraph\":\"